---
import "katex/dist/katex.min.css";
import Seo from "../components/Seo.astro";

const {
  title = "Writing on Software Engineering | Davit Maisuradze",
  description = "Notes on Python, Java, cloud architecture, and building products.",
  canonical,
  image,
  imageAlt,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  nofollow = false,
  structuredData = [],
} = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path = "") => `${base}${path}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noindex={noindex}
      nofollow={nofollow}
      structuredData={structuredData}
    />
    <meta name="theme-color" content="#161513" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={withBase("style.css")} />
    <link rel="stylesheet" href={withBase("blog.css")} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="icon" href={withBase("resources/images/tab-icon.png")} type="image/png" />
  </head>
  <body class="blog-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <footer class="site-footer blog-footer">
      <p>© {new Date().getFullYear()} Davit Maisuradze</p>
      <a href={withBase("")}>Portfolio</a>
    </footer>
  </body>
</html>
