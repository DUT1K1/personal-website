      { name: "ECS", usedIn: ["exp-gakvetili"] },
      { name: "S3", usedIn: ["exp-gakvetili"] },
      { name: "Lambda", usedIn: ["exp-epam-junior"] },
      { name: "IAM", usedIn: [] },
      { name: "VPC", usedIn: [] },
      { name: "ALB", usedIn: ["exp-quantori-bootcamp"] },
      { name: "Serverless", usedIn: ["exp-epam-junior"] },
      { name: "AWS Syndicate", usedIn: ["exp-epam-junior"] },
      { name: "Docker", usedIn: ["exp-quantori-bootcamp", "exp-gakvetili"] },
      { name: "Containerization", usedIn: ["exp-quantori-bootcamp", "exp-gakvetili"] },
