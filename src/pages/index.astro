---
import { getCollection } from "astro:content";
import CommandPalette from "../components/CommandPalette.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Seo from "../components/Seo.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SkillsExplorer from "../components/SkillsExplorer.astro";
import TerminalMode from "../components/TerminalMode.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path = "") => `${base}${path}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homepageUrl = new URL(Astro.url.pathname, siteUrl);
const personId = `${new URL("/", siteUrl).href}#davit-maisuradze`;
const profileImageUrl = new URL(withBase("resources/images/prof-pic.png"), siteUrl).href;
const seoTitle = "Davit Maisuradze — Software Developer & Tech Lead";
const seoDescription =
  "Davit Maisuradze is a software developer and tech lead in Tbilisi building backend systems and digital products with Java, Python, Spring Boot, and AWS.";
const profileStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${homepageUrl.href}#profile-page`,
  url: homepageUrl.href,
  name: seoTitle,
  description: seoDescription,
  mainEntity: {
    "@type": "Person",
    "@id": personId,
    name: "Davit Maisuradze",
    alternateName: "David Maisuradze",
    url: homepageUrl.href,
    image: {
      "@type": "ImageObject",
      url: profileImageUrl,
      width: 1024,
      height: 1024,
    },
    description: seoDescription,
    jobTitle: ["Software Developer", "Tech Lead", "Educator"],
    sameAs: [
      "https://www.linkedin.com/in/david-maisuradze2004/",
      "https://github.com/DUT1K1",
    ],
    worksFor: [
      {
        "@type": "Organization",
        name: "Quantori",
      },
      {
        "@type": "Organization",
        name: "Gakvetili.ge",
        url: "https://gakvetili.ge/",
      },
    ],
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "Kutaisi International University",
    },
    homeLocation: {
      "@type": "Place",
      name: "Tbilisi, Georgia",
    },
    knowsAbout: [
      "Java",
      "Python",
      "Spring Boot",
      "AWS",
      "Backend engineering",
      "Software architecture",
      "Technical leadership",
    ],
  },
};
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${new URL("/", siteUrl).href}#website`,
  url: new URL("/", siteUrl).href,
  name: "Davit Maisuradze",
  alternateName: "David Maisuradze",
  inLanguage: "en",
};

const projects = [
  {
    title: "New Legal Group",
    kicker: "Web design & development",
    description:
      "A multilingual website I designed and implemented for a Georgian legal firm, with a refined editorial system and clear paths to services, team information, and contact.",
    details:
      "The work covered the experience end to end—from the visual direction and responsive page system to production implementation. The result presents complex legal information in a calm, credible format across devices and languages.",
    highlights: ["UX/UI design", "Responsive implementation", "Multilingual experience"],
    href: "https://newlegal.ge/",
    image: withBase("resources/images/newlegal-project.webp"),
    imageAlt: "New Legal Group website sharing banner",
    detailImage: withBase("resources/images/newlegal-project.webp"),
    detailImageAlt: "New Legal Group website presentation",
    linkLabel: "Visit live site",
    width: 1200,
    height: 630,
  },
  {
    title: "Gakvetili.ge",
    kicker: "Platform & product engineering",
    description:
      "A platform I built to connect students with private tutors, covering tutor profiles, discovery, availability, bookings, payments, notifications, and operational tooling.",
    details:
      "I developed the product across its core operational flows, balancing the student experience with the tools tutors and the platform team need to manage lessons reliably from discovery through booking.",
    highlights: ["Product engineering", "Java & Spring Boot", "Platform operations"],
    href: "https://gakvetili.ge/",
    image: withBase("resources/images/gakvetili-project.jpg"),
    imageAlt: "Gakvetili.ge private tutors platform sharing banner",
    detailImage: withBase("resources/images/gakvetili-project.jpg"),
    detailImageAlt: "Gakvetili.ge private tutors platform presentation",
    linkLabel: "Visit live site",
    width: 1731,
    height: 909,
  },
  {
    title: "Gym Management application",
    kicker: "Java · AWS · Microservices",
    description:
      "A microservices-based gym management system built with Java and AWS, focused on secure and scalable member and training workflows.",
    details:
      "The project explores clear service boundaries and cloud-backed workflows for managing members, trainers, and sessions, with an emphasis on maintainable backend architecture.",
    highlights: ["Java", "AWS", "Microservices"],
    href: "https://github.com/DUT1K1/gym-microservies",
    image: withBase("resources/images/gym.webp"),
    imageAlt: "Gym Management application",
    linkLabel: "View on GitHub",
  },
  {
    title: "University Management System",
    kicker: "Java · Spring",
    description:
      "A Java and Spring system for organizing university operations, academic records, and the workflows shared by students and staff.",
    details:
      "It brings common academic workflows into one system, giving students and staff clearer ways to manage records and the day-to-day processes surrounding university life.",
    highlights: ["Java", "Spring", "Academic workflows"],
    href: "https://github.com/DUT1K1/University-Management-System",
    image: withBase("resources/images/university-app.webp"),
    imageAlt: "University Management System",
    linkLabel: "View on GitHub",
  },
  {
    title: "ToDo REST API",
    kicker: "Java · REST API",
    description:
      "A REST API for creating, organizing, and tracking tasks, built around clear endpoints and a maintainable backend structure.",
    details:
      "The project focuses on predictable resource design, validation, persistence, and error handling—the foundations of a clean backend service that is straightforward to extend.",
    highlights: ["Java", "REST design", "Backend architecture"],
    href: "https://github.com/DUT1K1/ToDo-REST-API",
    image: withBase("resources/images/todo-app.webp"),
    imageAlt: "ToDo REST API interface",
    linkLabel: "View on GitHub",
  },
  {
    title: "RESTful Weather API",
    kicker: "Java · REST API",
    description:
      "A focused RESTful service that retrieves and presents forecast data through an external weather API integration.",
    details:
      "It wraps an external forecast provider behind a focused API, keeping integration concerns separate from the client-facing contract and presenting weather data consistently.",
    highlights: ["Java", "External API integration", "REST design"],
    href: "https://github.com/DUT1K1/Weather-API",
    image: withBase("resources/images/weather-app.webp"),
    imageAlt: "RESTful Weather API interface",
    linkLabel: "View on GitHub",
  },
];

const projectId = (title) =>
  `project-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`;

const experiences = [
  {
    id: "exp-quantori",
    logo: withBase("resources/images/quantori_logo.jpeg"),
    logoAlt: "Quantori Logo",
    title: "Python Software Developer (Remote)",
    shortTitle: "Python Developer · Quantori",
    start: "Mar 2026",
    paragraphs: [],
  },
  {
    id: "exp-quantori-bootcamp",
    logo: withBase("resources/images/quantori_logo.jpeg"),
    logoAlt: "Quantori Logo",
    title: "Python Cloud Architect Bootcamp (Remote)",
    shortTitle: "Cloud Architect Bootcamp · Quantori",
    start: "Sept 2025",
    end: "Mar 2026",
    paragraphs: [
      "I'm taking part in a Quantori bootcamp focused on modern Python and cloud fundamentals. Each week I'm joining deep-dive lectures and labs covering Docker, Kubernetes, databases, messaging, testing, and deployment patterns—always tying concepts back to real-world workflows.",
      "I'm submitting biweekly projects that go beyond plain coding drills. Every assignment is framed around a practical theme, so I'm practicing design, documentation, and testing alongside the implementation. This keeps me building production-minded solutions instead of toy examples.",
      "As a pet project, I'm developing a Cheminformatics API that lets users run molecular substructure searches. I'm enforcing strict request validation, adding caching for hot queries, and offloading heavy computations to async workers to keep the API responsive. I'm containerizing the whole stack, deploying behind a load balancer, and instrumenting logs so performance and reliability are continuously monitored.",
      "Overall, I'm strengthening end-to-end skills—writing clean Python services, packaging them with containers, and delivering features with an eye for scalability, resilience, and developer experience.",
    ],
  },
  {
    id: "exp-gakvetili",
    logo: withBase("resources/images/gakvetili_logo.jpg"),
    logoAlt: "Gakvetili.ge logo",
    title: "CTO, Tech Lead (Tbilisi, Georgia)",
    shortTitle: "CTO & Tech Lead · Gakvetili.ge",
    start: "June 2025",
    paragraphs: [
      "I'm leading the build of Memora, an online platform for private tutors and students, owning the backend and delivery end-to-end. I'm keeping the stack lean, releases frequent, and the UX snappy.",
      "I'm bootstrapping a Spring Boot 3 monorepo, wiring CI/CD, and running Postgres/Redis. I'm shipping secure JWT auth with email verification and feature-flagged social login, while designing the core domain—tutors, listings, availability, bookings, payments, and reviews. I'm building fast search, generating slots, and driving a hold-then-pay booking flow with refunds and recurring lessons.",
      "On AWS, I'm containerizing to ECR and running on ECS Fargate with RDS, S3 (signed URLs), CloudFront, and WAF. I'm adding observability with CloudWatch and Micrometer/Prometheus, and I'm maintaining automated backups and recovery drills.",
      "I'm delivering reliable notifications with an outbox + MQ and integrating Google Meet so confirmed bookings are getting join links. I'm rolling out an admin review panel with RBAC, rate limits, PII scoping, and audit trails—keeping costs low while moving fast.",
    ],
  },
  {
    id: "exp-mziuri",
    logo: withBase("resources/images/mziuri.jpg"),
    logoAlt: "MZIURI logo",
    title: "Java Teacher at MZIURI (Remote)",
    shortTitle: "Java Teacher · MZIURI",
    start: "Sept 2023",
    paragraphs: [
      "I'm teaching Java to kids and teens at MZIURI School, focusing on problem-solving, clean coding habits, and the core concepts of programming. My classes keep things practical and fun, with lots of hands-on exercises and real examples.",
      "By the end of the course, students are designing and building their own small Java projects—typically desktop apps packaged as runnable JARs. Along the way they learn OOP, collections, error handling, basic testing, and how to structure code they can actually maintain.",
      "Day to day, I'm planning and explaining each lesson clearly, assigning and grading homework almost every class, and giving targeted feedback so students improve quickly. I also curate engaging Java resources, sample code, and mini-challenges to keep motivation high.",
      "Because high-quality Java materials in Georgian are hard to find, I'm actively writing and publishing free, Georgian-language Java content so learners (and other teachers) have accessible, local resources they can rely on.",
    ],
  },
  {
    id: "exp-epam-junior",
    logo: withBase("resources/images/epam-logo.jpeg"),
    logoAlt: "EPAM Systems logo",
    title: "Junior Java Developer at EPAM Systems (Remote)",
    shortTitle: "Junior Java Developer · EPAM",
    start: "Jul 2024",
    end: "Oct 2024",
    paragraphs: [
      "Built a serverless gym management app using AWS Lambda, API Gateway, DynamoDB, and Cognito for secure and scalable operations.",
    ],
  },
  {
    id: "exp-epam-intern",
    logo: withBase("resources/images/epam-logo.jpeg"),
    logoAlt: "EPAM Systems logo",
    title: "Java Backend Intern at EPAM Systems (Remote)",
    shortTitle: "Java Backend Intern · EPAM",
    start: "Jan 2024",
    end: "Jul 2024",
    paragraphs: [
      "Developed a scalable Java backend application utilizing Spring under the guidance of senior developers, gaining hands-on experience in building robust enterprise solutions.",
    ],
  },
];

// Where each skill shows up. Ids point at experience items and project cards
// on this page; the skills explorer turns them into jump links.
const gym = projectId("Gym Management application");
const university = projectId("University Management System");
const todo = projectId("ToDo REST API");
const weather = projectId("RESTful Weather API");
const gakvetiliProject = projectId("Gakvetili.ge");
const newLegal = projectId("New Legal Group");

const skillGroups = [
  {
    label: "Java Development",
    skills: [
      { name: "Java SE/EE", usedIn: ["exp-gakvetili", "exp-mziuri", "exp-epam-junior", "exp-epam-intern", gym, university, todo, weather] },
      { name: "Spring Framework", usedIn: ["exp-epam-intern", university] },
      { name: "Spring Boot", usedIn: ["exp-gakvetili", gakvetiliProject] },
      { name: "Spring Security", usedIn: ["exp-gakvetili"] },
