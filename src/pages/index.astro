      { name: "Microservices", usedIn: [gym] },
    ],
  },
  {
    label: "Python Development",
    skills: [
      { name: "Core Python", usedIn: ["exp-quantori", "exp-quantori-bootcamp"] },
      { name: "FastAPI", usedIn: ["exp-quantori-bootcamp"] },
      { name: "Pandas", usedIn: [] },
      { name: "NumPy", usedIn: [] },
      { name: "Pytest", usedIn: ["exp-quantori-bootcamp"] },
