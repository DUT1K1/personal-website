const email = "david.maisuradze0920@gmail.com";
const resumeHref = withBase("resources/files/David Maisuradze Resume.pdf");
const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf());

const paletteSections = [
  ["home", "Home", "fa-solid fa-house"],
  ["about", "About me", "fa-solid fa-user"],
  ["now", "What I'm doing now", "fa-solid fa-seedling"],
  ["skills", "Skills", "fa-solid fa-screwdriver-wrench"],
  ["experience", "Experience", "fa-solid fa-briefcase"],
  ["projects", "Projects", "fa-solid fa-layer-group"],
  ["education", "Education", "fa-solid fa-graduation-cap"],
  ["academic", "Research & conferences", "fa-solid fa-flask"],
  ["contact", "Contact", "fa-solid fa-paper-plane"],
];

const terminalData = {
  email,
  resume: resumeHref,
  about: [
    "Hello, I'm David Maisuradze, a passionate Java Developer based in Tbilisi, Georgia. I specialize in building scalable applications using Spring and Spring Boot, with a strong focus on crafting robust RESTful APIs and microservices architectures. My expertise in Hibernate and AWS integration has enabled me to deliver full-stack projects and develop secure, high-performance software solutions.",
    "My professional journey includes mentoring young talents as a Java Teacher, where I help students build their programming skills through hands-on projects. I have also contributed as a Junior Java Developer at EPAM Systems, where I built serverless applications and honed my skills during an internship developing scalable backend systems.",
  ],
  now: "I'm currently working at Quantori as a Python Software Developer. At the same time, I'm building the Gakvetili.ge backend with Java and Spring Boot, and learning a lot through the project. I'm also on the final steps of my bachelor's thesis.",
  projects: projects.map((project) => ({ ...project, id: projectId(project.title) })),
  experiences,
  skills: skillGroups,
  places: skillPlaces,
  posts: blogPosts.map((post) => ({
    slug: post.id.replace(/\.mdx?$/, ""),
    title: post.data.title,
    description: post.data.description,
    date: post.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }),
    href: withBase(`blog/${post.id.replace(/\.mdx?$/, "")}/`),
  })),
};

const paletteItems = [
  ...paletteSections.map(([id, label, icon]) => ({
    id: `section-${id}`,
    group: "Go to",
    label,
    icon,
    keywords: id,
    action: { type: "section", value: id },
  })),
  ...projects.map((project) => ({
    id: projectId(project.title),
    group: "Projects",
    label: project.title,
    hint: project.kicker,
    icon: "fa-solid fa-layer-group",
    keywords: project.highlights.join(" "),
    action: { type: "project", value: projectId(project.title) },
  })),
  {
    id: "blog",
    group: "Writing",
    label: "All posts",
    icon: "fa-solid fa-pen-nib",
    keywords: "blog articles writing",
    action: { type: "link", value: withBase("blog/") },
