    hint: "Notion",
    icon: "fa-brands fa-java",
    keywords: "teaching learn notion",
    action: {
      type: "external",
      value: "https://opalescent-hub-1c1.notion.site/13fe260c066180d79b4dc85eb505f47f",
    },
  },
  ...skillGroups.flatMap((group) =>
    group.skills.map((skill) => ({
