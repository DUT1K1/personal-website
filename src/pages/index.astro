<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={seoTitle}
      description={seoDescription}
      canonical={homepageUrl}
      type="profile"
      structuredData={[websiteStructuredData, profileStructuredData]}
    />
    <meta name="theme-color" content="#161513" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={withBase("style.css")} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="icon" href={withBase("resources/images/tab-icon.png")} type="image/png" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <!-- Header / Navigation -->
    <SiteHeader currentPath="/" />

    <main id="main-content">
      <!-- Home Section -->
      <section id="home" class="container hero-section reveal" aria-labelledby="home-title">
        <canvas class="hero-field" aria-hidden="true" data-hero-field></canvas>
        <div class="hero">
          <div class="hero-copy">
            <p class="eyebrow">Software developer · Tech lead · Educator</p>
            <h1 id="home-title">Hi, I'm <span>Davit Maisuradze</span></h1>
            <p class="hero-lead">
              I'm the CTO and Tech Lead at <a class="gakvetili-link" href="https://gakvetili.ge"
                target="_blank" rel="noopener noreferrer">Gakvetili.ge</a
              >, and I also work as a
              Python Software Developer at Quantori.
            </p>

            <div class="about-btn">
              <a href="#contact" class="btn-primary">Get In Touch</a>
              <a href={resumeHref} download class="btn-secondary"
                >Download Resume <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a
              >
            </div>

            <ul class="hero-meta">
              <li>
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <span>Tbilisi, Georgia</span>
                <span class="hero-clock" data-local-time hidden>
                  · <time data-local-time-value></time>
                  <span class="hero-clock-note" data-local-time-note></span>
                </span>
              </li>
              <li class="hero-palette-hint">
                <button type="button" class="kbd-hint" data-cmdk-open>
                  <span>Jump anywhere</span>
                  <kbd data-mod-key>⌘</kbd><kbd>K</kbd>
                </button>
                <button type="button" class="kbd-hint" data-term-open>
                  <span>Terminal</span>
                  <kbd>`</kbd>
                </button>
              </li>
            </ul>
          </div>

          <div class="hero-visual">
            <div class="avatar" data-avatar-tilt>
              <img
                src={withBase("resources/images/prof-pic.webp")}
                alt="Portrait of Davit Maisuradze"
                width="251"
                height="251"
                decoding="async"
                fetchpriority="high"
                draggable="false"
