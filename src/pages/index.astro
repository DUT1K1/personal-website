---
import ProjectCard from "../components/ProjectCard.astro";
import Seo from "../components/Seo.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path = "") => `${base}${path}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homepageUrl = new URL(Astro.url.pathname, siteUrl);
const personId = `${new URL("/", siteUrl).href}#davit-maisuradze`;
const profileImageUrl = new URL(withBase("resources/images/prof-pic.png"), siteUrl).href;
const seoTitle = "Davit Maisuradze — Software Developer & Tech Lead";
const seoDescription =
  "Davit Maisuradze is a software developer and tech lead in Tbilisi building backend systems and digital products with Java, Python, Spring Boot, and AWS.";
const profileStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${homepageUrl.href}#profile-page`,
  url: homepageUrl.href,
  name: seoTitle,
  description: seoDescription,
  mainEntity: {
    "@type": "Person",
    "@id": personId,
    name: "Davit Maisuradze",
    alternateName: "David Maisuradze",
    url: homepageUrl.href,
    image: {
      "@type": "ImageObject",
      url: profileImageUrl,
      width: 1024,
      height: 1024,
    },
    description: seoDescription,
    jobTitle: ["Software Developer", "Tech Lead", "Educator"],
    sameAs: [
      "https://www.linkedin.com/in/david-maisuradze2004/",
      "https://github.com/DUT1K1",
    ],
    worksFor: [
      {
        "@type": "Organization",
        name: "Quantori",
      },
      {
        "@type": "Organization",
        name: "Gakvetili.ge",
        url: "https://gakvetili.ge/",
      },
    ],
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "Kutaisi International University",
    },
    homeLocation: {
      "@type": "Place",
      name: "Tbilisi, Georgia",
    },
    knowsAbout: [
      "Java",
      "Python",
      "Spring Boot",
      "AWS",
      "Backend engineering",
      "Software architecture",
      "Technical leadership",
    ],
  },
};

const projects = [
  {
    title: "New Legal Group",
    kicker: "Web design & development",
    description:
      "A multilingual website I designed and implemented for a Georgian legal firm, with a refined editorial system and clear paths to services, team information, and contact.",
    details:
      "The work covered the experience end to end—from the visual direction and responsive page system to production implementation. The result presents complex legal information in a calm, credible format across devices and languages.",
    highlights: ["UX/UI design", "Responsive implementation", "Multilingual experience"],
    href: "https://newlegal.ge/",
    image: withBase("resources/images/newlegal-project.webp"),
    imageAlt: "New Legal Group website sharing banner",
    detailImage: withBase("resources/images/newlegal-project.webp"),
    detailImageAlt: "New Legal Group website presentation",
    linkLabel: "Visit live site",
    width: 1200,
    height: 630,
  },
  {
    title: "Gakvetili.ge",
    kicker: "Platform & product engineering",
    description:
      "A platform I built to connect students with private tutors, covering tutor profiles, discovery, availability, bookings, payments, notifications, and operational tooling.",
    details:
      "I developed the product across its core operational flows, balancing the student experience with the tools tutors and the platform team need to manage lessons reliably from discovery through booking.",
    highlights: ["Product engineering", "Java & Spring Boot", "Platform operations"],
    href: "https://gakvetili.ge/",
    image: withBase("resources/images/gakvetili-project.jpg"),
    imageAlt: "Gakvetili.ge private tutors platform sharing banner",
    detailImage: withBase("resources/images/gakvetili-project.jpg"),
    detailImageAlt: "Gakvetili.ge private tutors platform presentation",
    linkLabel: "Visit live site",
    width: 1731,
    height: 909,
  },
  {
    title: "Gym Management application",
    kicker: "Java · AWS · Microservices",
    description:
      "A microservices-based gym management system built with Java and AWS, focused on secure and scalable member and training workflows.",
    details:
      "The project explores clear service boundaries and cloud-backed workflows for managing members, trainers, and sessions, with an emphasis on maintainable backend architecture.",
    highlights: ["Java", "AWS", "Microservices"],
    href: "https://github.com/DUT1K1/gym-microservies",
    image: withBase("resources/images/gym.png"),
    imageAlt: "Gym Management application",
    linkLabel: "View on GitHub",
  },
  {
    title: "University Management System",
    kicker: "Java · Spring",
    description:
      "A Java and Spring system for organizing university operations, academic records, and the workflows shared by students and staff.",
    details:
      "It brings common academic workflows into one system, giving students and staff clearer ways to manage records and the day-to-day processes surrounding university life.",
    highlights: ["Java", "Spring", "Academic workflows"],
    href: "https://github.com/DUT1K1/University-Management-System",
    image: withBase("resources/images/university-app.png"),
    imageAlt: "University Management System",
    linkLabel: "View on GitHub",
  },
  {
    title: "ToDo REST API",
    kicker: "Java · REST API",
    description:
      "A REST API for creating, organizing, and tracking tasks, built around clear endpoints and a maintainable backend structure.",
    details:
      "The project focuses on predictable resource design, validation, persistence, and error handling—the foundations of a clean backend service that is straightforward to extend.",
    highlights: ["Java", "REST design", "Backend architecture"],
    href: "https://github.com/DUT1K1/ToDo-REST-API",
    image: withBase("resources/images/todo-app.png"),
    imageAlt: "ToDo REST API interface",
    linkLabel: "View on GitHub",
  },
  {
    title: "RESTful Weather API",
    kicker: "Java · REST API",
    description:
      "A focused RESTful service that retrieves and presents forecast data through an external weather API integration.",
    details:
      "It wraps an external forecast provider behind a focused API, keeping integration concerns separate from the client-facing contract and presenting weather data consistently.",
    highlights: ["Java", "External API integration", "REST design"],
    href: "https://github.com/DUT1K1/Weather-API",
    image: withBase("resources/images/weather-app.png"),
    imageAlt: "RESTful Weather API interface",
    linkLabel: "View on GitHub",
  },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={seoTitle}
      description={seoDescription}
      canonical={homepageUrl}
      type="profile"
      structuredData={profileStructuredData}
    />
    <meta name="theme-color" content="#161513" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={withBase("style.css")} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="icon" href={withBase("resources/images/tab-icon.png")} type="image/png" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <!-- Header / Navigation -->
    <header class="site-header">
      <nav aria-label="Primary navigation">
        <a class="site-brand" href="#home" aria-label="Davit Maisuradze, home">
          <span class="site-brand-mark" aria-hidden="true">DM</span>
          <span>Davit Maisuradze</span>
        </a>

        <button
          type="button"
          class="menu-toggle"
          aria-label="Toggle navigation"
          aria-controls="primary-nav"
          aria-expanded="false"
        >
          <i class="fa-solid fa-bars icon-open" aria-hidden="true"></i>
          <i class="fa-solid fa-xmark icon-close" aria-hidden="true"></i>
        </button>

        <div class="navbar" id="primary-nav">
          <a href="#about" class="nav-link">About</a>
          <a href="#experience" class="nav-link">Work</a>
          <a href="#projects" class="nav-link">Projects</a>
          <a href={withBase("blog/")} class="nav-link">Writing</a>
          <a href="#contact" class="nav-link nav-link-contact">Contact</a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <!-- Home Section -->
      <section id="home" class="container hero-section reveal" aria-labelledby="home-title">
        <div class="about">
          <div class="avatar">
            <img
              src={withBase("resources/images/prof-pic.png")}
              alt="Portrait of Davit Maisuradze"
              width="251"
              height="251"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <div class="about-text">
            <p class="eyebrow">Software developer · Tech lead · Educator</p>
            <h1 id="home-title">Hi, I'm <span>Davit Maisuradze</span></h1>
            <p>
              I'm the CTO and Tech Lead at <a class="gakvetili-link" href="https://gakvetili.ge"
                target="_blank" rel="noopener noreferrer">Gakvetili.ge</a
              >, and I also work as a
              Python Software Developer at Quantori.
            </p>
          </div>

          <div class="about-btn">
            <a href="#contact" class="btn-primary">Get In Touch</a>
            <a
              href={withBase("resources/files/David Maisuradze Resume.docx.pdf")}
              download
              class="btn-secondary"
              >Download Resume <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a
            >
          </div>
        </div>
      </section>

    <!-- About Section -->
    <section id="about" class="container reveal" aria-labelledby="about-title">
      <div class="about">
        <div class="about-text">
          <h2 id="about-title">About Me</h2>
          <p>
            Hello, I'm David Maisuradze, a passionate
            <span class="gradient-text">Java Developer</span> based in Tbilisi,
            Georgia. I specialize in building scalable applications using Spring
            and <span class="gradient-text">Spring Boot</span>, with a strong
            focus on crafting robust RESTful APIs and microservices
            architectures. My expertise in Hibernate and AWS integration has
            enabled me to deliver full-stack projects and develop secure,
            <span class="gradient-text">high-performance</span> software
            solutions.
          </p>
          <p>
            My professional journey includes mentoring young talents as a
            <span class="gradient-text">Java Teacher</span>, where I help
            students build their programming skills through hands-on projects. I
            have also contributed as a Junior Java Developer at
            <span class="gradient-text">EPAM Systems</span>, where I built
            serverless applications and honed my skills during an internship
            developing scalable
            <span class="gradient-text">backend</span> systems. My
            projects—ranging from a gym management application to a
            comprehensive university management system—demonstrate my commitment
            to innovation and excellence in the tech industry.
          </p>
        </div>
      </div>
    </section>

    <section id="now" class="container reveal" aria-labelledby="now-title">
      <h2 id="now-title" class="primary-heading">Now</h2>
      <div class="now-card">
        <p>
          I'm currently working at Quantori as a Python Software Developer. At
          the same time, I'm building the <a class="gakvetili-link" href="https://gakvetili.ge"
            target="_blank" rel="noopener noreferrer">Gakvetili.ge</a
          > backend with Java and
          Spring Boot, and learning a lot through the project. I'm also on the
          final steps of my bachelor's thesis, which should be ready in the next
          one or two months.
        </p>
        <p class="now-meta">Last updated: <time datetime="2026-03">March 2026</time></p>
      </div>
    </section>

    <section id="skills" class="container reveal" aria-labelledby="skills-title">
      <h2 id="skills-title" class="primary-heading">Skills</h2>
      <div class="skills-rows">
        <div class="skills-row">
          <div class="skills-label">Java Development</div>
          <div class="skills-grid">
            <span class="skill-chip"><span>Java SE/EE</span></span>
            <span class="skill-chip"><span>Spring Framework</span></span>
            <span class="skill-chip"><span>Spring Boot</span></span>
            <span class="skill-chip"><span>Spring Security</span></span>
            <span class="skill-chip"><span>Maven</span></span>
            <span class="skill-chip"><span>JUnit</span></span>
            <span class="skill-chip"><span>Mockito</span></span>
            <span class="skill-chip"><span>REST</span></span>
            <span class="skill-chip"><span>Microservices</span></span>
          </div>
        </div>
        <div class="skills-row">
          <div class="skills-label">Python Development</div>
          <div class="skills-grid">
            <span class="skill-chip"><span>Core Python</span></span>
            <span class="skill-chip"><span>FastAPI</span></span>
            <span class="skill-chip"><span>Pandas</span></span>
            <span class="skill-chip"><span>NumPy</span></span>
            <span class="skill-chip"><span>Pytest</span></span>
          </div>
        </div>
        <div class="skills-row">
          <div class="skills-label">Web Development</div>
          <div class="skills-grid">
            <span class="skill-chip"><span>HTML</span></span>
            <span class="skill-chip"><span>CSS</span></span>
            <span class="skill-chip"><span>JavaScript</span></span>
            <span class="skill-chip"><span>React</span></span>
            <span class="skill-chip"><span>Thymeleaf</span></span>
            <span class="skill-chip"><span>HTTP</span></span>
            <span class="skill-chip"><span>Tomcat</span></span>
            <span class="skill-chip"><span>JSON</span></span>
            <span class="skill-chip"><span>XML</span></span>
          </div>
        </div>
        <div class="skills-row">
          <div class="skills-label">Cloud Computing</div>
          <div class="skills-grid">
            <span class="skill-chip"><span>AWS</span></span>
            <span class="skill-chip"><span>EC2</span></span>
            <span class="skill-chip"><span>ECS</span></span>
            <span class="skill-chip"><span>S3</span></span>
            <span class="skill-chip"><span>Lambda</span></span>
            <span class="skill-chip"><span>IAM</span></span>
            <span class="skill-chip"><span>VPC</span></span>
            <span class="skill-chip"><span>ALB</span></span>
            <span class="skill-chip"><span>Serverless</span></span>
            <span class="skill-chip"><span>AWS Syndicate</span></span>
            <span class="skill-chip"><span>Docker</span></span>
            <span class="skill-chip"><span>Containerization</span></span>
          </div>
        </div>
        <div class="skills-row">
          <div class="skills-label">Version Control</div>
          <div class="skills-grid">
            <span class="skill-chip"><span>Git</span></span>
            <span class="skill-chip"><span>GitHub</span></span>
            <span class="skill-chip"><span>GitLab</span></span>
          </div>
        </div>
        <div class="skills-row">
          <div class="skills-label">Database Management</div>
          <div class="skills-grid">
            <span class="skill-chip"><span>MySQL</span></span>
            <span class="skill-chip"><span>PostgreSQL</span></span>
            <span class="skill-chip"><span>MongoDB</span></span>
            <span class="skill-chip"><span>DynamoDB</span></span>
            <span class="skill-chip"><span>JDBC</span></span>
            <span class="skill-chip"><span>JPA</span></span>
            <span class="skill-chip"><span>Hibernate</span></span>
            <span class="skill-chip"><span>Flyway</span></span>
            <span class="skill-chip"><span>Alembic</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="container reveal" aria-labelledby="experience-title">
      <h2 id="experience-title" class="primary-heading heading-experience">Experience</h2>
      
      <!-- Python software developer in Quantori -->
      <div class="experience-item experience-item-current">
        <div class="experience-header">
          <div class="experience-left">
            <img
              src={withBase("resources/images/quantori_logo.jpeg")}
              alt="Quantori Logo"
              class="company-logo"
              loading="lazy"
            />
            <span class="experience-title"
              >Python Software Developer (Remote)</span
            >
          </div>
          <div class="date">Mar 2026 – <span class="present-label">Present</span></div>
        </div>
      </div>

      <!-- Python cloud architect bootcamp in Quantori -->
      <div class="experience-item">
        <div class="experience-header">
          <div class="experience-left">
            <img
              src={withBase("resources/images/quantori_logo.jpeg")}
              alt="Quantori Logo"
              class="company-logo"
              loading="lazy"
            />
            <span class="experience-title"
              >Python Cloud Architect Bootcamp (Remote)</span
            >
          </div>
          <div class="date">Sept 2025 – Mar 2026</div>
        </div>
        <p>
          I'm taking part in a Quantori bootcamp focused on modern Python and cloud fundamentals. Each week I'm joining deep-dive lectures and labs covering Docker, Kubernetes, databases, messaging, testing, and deployment patterns—always tying concepts back to real-world workflows.<br><br>

          I'm submitting biweekly projects that go beyond plain coding drills. Every assignment is framed around a practical theme, so I'm practicing design, documentation, and testing alongside the implementation. This keeps me building production-minded solutions instead of toy examples.<br><br>

          As a pet project, I'm developing a Cheminformatics API that lets users run molecular substructure searches. I'm enforcing strict request validation, adding caching for hot queries, and offloading heavy computations to async workers to keep the API responsive. I'm containerizing the whole stack, deploying behind a load balancer, and instrumenting logs so performance and reliability are continuously monitored.<br><br>

          Overall, I'm strengthening end-to-end skills—writing clean Python services, packaging them with containers, and delivering features with an eye for scalability, resilience, and developer experience.
        </p>
      </div>

      <!-- Gakvetili.ge CTO tech lead -->
      <div class="experience-item experience-item-current">
        <div class="experience-header">
          <div class="experience-left">
            <img
              src={withBase("resources/images/gakvetili_logo.jpg")}
              alt="Gakvetili.ge logo"
              class="company-logo"
              loading="lazy"
            />
            <span class="experience-title"
              >CTO, Tech Lead (Tbilisi, Georgia)</span
            >
          </div>
          <div class="date">June 2025 – <span class="present-label">Present</span></div>
        </div>
        <p>
          I'm leading the build of Memora, an online platform for private tutors and students, owning the backend and delivery end-to-end. I'm keeping the stack lean, releases frequent, and the UX snappy.<br><br>

          I'm bootstrapping a Spring Boot 3 monorepo, wiring CI/CD, and running Postgres/Redis. I'm shipping secure JWT auth with email verification and feature-flagged social login, while designing the core domain—tutors, listings, availability, bookings, payments, and reviews. I'm building fast search, generating slots, and driving a hold-then-pay booking flow with refunds and recurring lessons.<br><br>

          On AWS, I'm containerizing to ECR and running on ECS Fargate with RDS, S3 (signed URLs), CloudFront, and WAF. I'm adding observability with CloudWatch and Micrometer/Prometheus, and I'm maintaining automated backups and recovery drills.<br><br>

          I'm delivering reliable notifications with an outbox + MQ and integrating Google Meet so confirmed bookings are getting join links. I'm rolling out an admin review panel with RBAC, rate limits, PII scoping, and audit trails—keeping costs low while moving fast.
        </p>
      </div>

      <!-- Java Teacher at MZIURI -->
      <div class="experience-item experience-item-current">
        <div class="experience-header">
          <div class="experience-left">
            <img
              src={withBase("resources/images/mziuri.jpg")}
              alt="MZIURI logo"
              class="company-logo"
              loading="lazy"
            />
            <span class="experience-title"
              >Java Teacher at MZIURI (Remote)</span
            >
          </div>
          <div class="date">Sept 2023 – <span class="present-label">Present</span></div>
        </div>
        <p>
          I'm teaching Java to kids and teens at MZIURI School, focusing on problem-solving, clean coding habits, and the core concepts of programming. My classes keep things practical and fun, with lots of hands-on exercises and real examples.<br><br>

          By the end of the course, students are designing and building their own small Java projects—typically desktop apps packaged as runnable JARs. Along the way they learn OOP, collections, error handling, basic testing, and how to structure code they can actually maintain.<br><br>

          Day to day, I'm planning and explaining each lesson clearly, assigning and grading homework almost every class, and giving targeted feedback so students improve quickly. I also curate engaging Java resources, sample code, and mini-challenges to keep motivation high.<br><br>

          Because high-quality Java materials in Georgian are hard to find, I'm actively writing and publishing free, Georgian-language Java content so learners (and other teachers) have accessible, local resources they can rely on.
        </p>
      </div>

      <!-- Junior Java Developer at EPAM Systems -->
      <div class="experience-item">
        <div class="experience-header">
          <div class="experience-left">
            <img
              src={withBase("resources/images/epam-logo.jpeg")}
              alt="EPAM Systems logo"
              class="company-logo"
              loading="lazy"
            />
            <span class="experience-title"
              >Junior Java Developer at EPAM Systems (Remote)</span
            >
          </div>
          <div class="date">Jul 2024 – Oct 2024</div>
        </div>
        <p>
          Built a serverless gym management app using AWS Lambda, API Gateway,
          DynamoDB, and Cognito for secure and scalable operations.
        </p>
      </div>

      <!-- Java Backend Intern at EPAM Systems -->
      <div class="experience-item">
        <div class="experience-header">
          <div class="experience-left">
            <img
              src={withBase("resources/images/epam-logo.jpeg")}
              alt="EPAM Systems logo"
              class="company-logo"
              loading="lazy"
            />
            <span class="experience-title"
              >Java Backend Intern at EPAM Systems (Remote)</span
            >
          </div>
          <div class="date">Jan 2024 – Jul 2024</div>
        </div>
        <p>
          Developed a scalable Java backend application utilizing Spring under
          the guidance of senior developers, gaining hands-on experience in
          building robust enterprise solutions.
        </p>
      </div>
    </section>

    <section id="projects" class="container reveal" aria-labelledby="projects-title">
      <h2 id="projects-title" class="primary-heading">
        <span class="orange-gradient">My Projects</span>
      </h2>
      <p class="section-intro">
        A selection of products and backend systems I have designed, built, and
        shipped.
      </p>
      <div class="projects">
        {projects.slice(0, 4).map((project) => <ProjectCard {...project} />)}
      </div>

      <details class="projects-more">
        <summary>
          <span class="projects-more-label projects-more-label-closed">See all projects</span>
          <span class="projects-more-label projects-more-label-open">Show fewer projects</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </summary>

        <div class="projects-more-content">
          <div class="projects projects-secondary">
            {projects.slice(4).map((project) => <ProjectCard {...project} />)}
          </div>
        </div>
      </details>
    </section>

    <!-- Education Section -->
    <section id="education" class="container reveal" aria-labelledby="education-title">
      <h2 id="education-title" class="primary-heading heading-experience">Education</h2>

      <!-- Bachelor of Computer Science -->
      <div class="experience-item">
          <div class="experience-header">
            <div class="experience-left">
              <img
                src={withBase("resources/images/kiu.jpeg")}
                alt="Kutaisi International University logo"
                class="company-logo"
                loading="lazy"
              />
              <span class="experience-title">Bachelor of Computer Science</span>
            </div>
            <div class="date">Sept 2022 – Jul 2026</div>
          </div>
          <p>
            Pursuing a degree in Computer Science at Kutaisi International
            University in Georgia, building a strong foundation in software
            development, algorithms, and emerging technologies.
          </p>
      </div>

      <!-- Add additional education items here if needed -->
    </section>

    <section id="academic" class="container reveal" aria-labelledby="academic-title">
      <h2 id="academic-title" class="primary-heading heading-experience">Academic Experience</h2>

      <!-- Research Experience -->
      <h2 class="sub-heading">Research Experience</h2>
      <div class="experience-item">
        <div class="experience-header">
          <div class="experience-left">
            <img
              src={withBase("resources/images/kiu.jpeg")}
              alt="Kutaisi International University logo"
              class="company-logo"
              loading="lazy"
            />
            <span class="experience-title">Bachelor Thesis: Derivatives of Regular Expressions with Fuzzy Similarity</span>
          </div>
          <div class="date">June 2025 – Present</div>
        </div>
        <p>
        This research extends classical derivatives of regular expressions by introducing fuzzy similarity relations. 
        Instead of matching symbols exactly, the derivative also considers symbols that are sufficiently similar under a chosen cut value. 
        This generalization enables approximate matching, making regular expressions more flexible for applications like pattern recognition and information retrieval.
        </p>
