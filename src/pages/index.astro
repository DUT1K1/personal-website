    <script is:inline src={withBase("scripts.js")}></script>
    <script>
      import { copyText, showToast } from "../scripts/home-ui.js";
      import { createHeroField } from "../scripts/hero-field.js";

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      // Keep the reading position across reloads. The browser restores a raw
      // pixel offset before the scripts reshape the page (the skills map, the
      // collapsed experience entries), so it lands a little lower every time.
      // Instead, remember which section was at the top and how far into it,
      // and restore that once the layout has settled.
      const SCROLL_KEY = "home-scroll";
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";

      // offsetTop ignores the reveal animation's transform, unlike getBoundingClientRect.
      const documentTop = (element) => {
        let top = 0;
        for (let node = element; node instanceof HTMLElement; node = node.offsetParent) {
          top += node.offsetTop;
        }
        return top;
      };

      window.addEventListener("pagehide", () => {
        const sections = Array.from(document.querySelectorAll("main > section[id]"));
        const anchor = sections.filter((section) => documentTop(section) <= window.scrollY + 1).at(-1);
        try {
          sessionStorage.setItem(
            SCROLL_KEY,
            JSON.stringify(anchor ? { id: anchor.id, offset: window.scrollY - documentTop(anchor) } : { id: null, offset: 0 })
          );
        } catch {
          // Private mode or blocked storage: the page simply opens at the top.
        }
      });

      const restoreScroll = () => {
        let saved = null;
        try {
          saved = JSON.parse(sessionStorage.getItem(SCROLL_KEY) ?? "null");
        } catch {
          saved = null;
        }
        const navigation = performance.getEntriesByType("navigation")[0];
        const isReload = navigation?.type === "reload" || navigation?.type === "back_forward";

        if (saved && isReload) {
          const anchor = saved.id ? document.getElementById(saved.id) : null;
          const top = anchor ? documentTop(anchor) + saved.offset : 0;
          window.scrollTo({ top, behavior: "instant" });
        } else if (location.hash) {
          document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView({ behavior: "instant" });
        }
      };

      // Wait for fonts and the widgets' first layout before measuring.
      Promise.race([document.fonts?.ready ?? Promise.resolve(), new Promise((resolve) => setTimeout(resolve, 600))]).then(() =>
        requestAnimationFrame(() => requestAnimationFrame(restoreScroll))
      );

      const heroCanvas = document.querySelector("[data-hero-field]");
      const heroField =
        heroCanvas instanceof HTMLCanvasElement
          ? createHeroField(heroCanvas, {
              reducedMotion: reducedMotion.matches,
              // The intro's ordering wave starts from the portrait.
              origin: () => {
                const portrait = document.querySelector("[data-avatar-tilt]");
                if (!portrait) return null;
                const canvasRect = heroCanvas.getBoundingClientRect();
                const rect = portrait.getBoundingClientRect();
                return {
                  x: rect.left + rect.width / 2 - canvasRect.left,
                  y: rect.top + rect.height / 2 - canvasRect.top,
                };
              },
            })
          : null;

      // Easter egg: the Konami code (or `supra` in the terminal) raises a toast,
      // Georgian style. The hero's dots regroup into "hello" in flag red.
      const KONAMI = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
      let konamiIndex = 0;
      let georgianFontRequested = false;

      const supra = () => {
        if (!georgianFontRequested) {
          georgianFontRequested = true;
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = `https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@800&display=swap&text=${encodeURIComponent("გამარჯობა")}`;
          document.head.append(link);
        }
        const hero = document.getElementById("home");
        hero?.scrollIntoView({ behavior: reducedMotion.matches ? "auto" : "smooth", block: "start" });
        hero?.classList.add("is-supra");
        window.setTimeout(() => hero?.classList.remove("is-supra"), 6500);
        void heroField?.spell("გამარჯობა", 6500);
        showToast("გამარჯობა! You found the supra. გაუმარჯოს! 🍷", "fa-wine-glass", 6000);
      };

      document.addEventListener("easter:supra", supra);
      document.addEventListener("keydown", (event) => {
        const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
        konamiIndex = key === KONAMI[konamiIndex] ? konamiIndex + 1 : key === KONAMI[0] ? 1 : 0;
        if (konamiIndex === KONAMI.length) {
          konamiIndex = 0;
          supra();
        }
      });

      // Live local time in Tbilisi, with how far ahead or behind the visitor is.
      const clock = document.querySelector("[data-local-time]");
      const clockValue = document.querySelector("[data-local-time-value]");
      const clockNote = document.querySelector("[data-local-time-note]");
      const tbilisiTime = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Tbilisi",
        hour: "2-digit",
        minute: "2-digit",
      });
      const tbilisiHour = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Tbilisi",
        hour: "numeric",
        hourCycle: "h23",
      });

      const describeOffset = (now) => {
        // Tbilisi is UTC+4 all year.
        const difference = 240 + now.getTimezoneOffset();
        if (difference === 0) return "same time as you";
        const hours = Math.abs(difference) / 60;
        const amount = Number.isInteger(hours) ? `${hours}h` : `${hours.toFixed(1)}h`;
        return `${amount} ${difference > 0 ? "ahead of" : "behind"} you`;
      };

      const tickClock = () => {
        if (!clock || !clockValue || !clockNote) return;
        const now = new Date();
        const hour = Number(tbilisiHour.format(now));
        clockValue.textContent = tbilisiTime.format(now);
        clockValue.dateTime = now.toISOString();
        clockNote.textContent =
          hour >= 1 && hour < 7 ? "(probably asleep)" : `(${describeOffset(now)})`;
        clock.hidden = false;
      };

      tickClock();
      window.setInterval(tickClock, 30_000);

      // Experience: long entries open in place.
      document.querySelectorAll("[data-experience-toggle]").forEach((toggle) => {
        const panel = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
        if (!panel) return;
        panel.inert = true;

        toggle.addEventListener("click", () => {
          const isOpen = toggle.getAttribute("aria-expanded") !== "true";
          toggle.setAttribute("aria-expanded", String(isOpen));
          panel.classList.toggle("is-open", isOpen);
          panel.inert = !isOpen;

          // Collapsing from far down the entry would otherwise leave the visitor
          // stranded below it.
          if (!isOpen) {
            const item = toggle.closest(".experience-item");
            const top = item?.getBoundingClientRect().top ?? 0;
            if (item && top < 0) {
              item.scrollIntoView({ behavior: reducedMotion.matches ? "auto" : "smooth", block: "start" });
            }
          }
        });
      });

      // Experience bus: each role is a bit (1 = active, 0 = past). The bus
      // line runs from the top of the list to the last bit, so measure where
      // that bit sits; "Read more" moves it, hence the observer.
      const timeline = document.querySelector(".timeline");
      const bus = document.querySelector(".bus");
      if (timeline instanceof HTMLElement && bus instanceof HTMLElement) {
        const lastLogo = timeline.querySelector(":scope > .experience-item:last-child .company-logo");
        const measure = () => {
          if (!lastLogo) return;
          // Both rects share any reveal transform, so the difference is exact.
          const logoRect = lastLogo.getBoundingClientRect();
          const length = logoRect.top + logoRect.height / 2 - timeline.getBoundingClientRect().top;
          bus.style.setProperty("--rail-length", `${Math.max(1, length)}px`);
        };
        measure();
        new ResizeObserver(measure).observe(timeline);
      }

      // Copy email: the button morphs to a confirmation, then settles back.
      document.querySelectorAll("[data-copy]").forEach((button) => {
        let resetTimer;
        button.addEventListener("click", async () => {
          const copied = await copyText(button.dataset.copy ?? "");
          if (!copied) {
            showToast("Couldn't reach the clipboard", "fa-triangle-exclamation");
            return;
          }
          button.classList.add("is-copied");
          button.setAttribute("aria-label", "Email address copied");
          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            button.classList.remove("is-copied");
            button.setAttribute("aria-label", "Copy email address");
          }, 1800);
        });
      });

      // Project cards: a soft light follows the pointer.
      if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        document.querySelectorAll(".project-card-front").forEach((card) => {
          card.addEventListener("pointermove", (event) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty("--spot-x", `${event.clientX - rect.left}px`);
            card.style.setProperty("--spot-y", `${event.clientY - rect.top}px`);
          });
        });
      }

      // Portrait: a gentle tilt toward the pointer, eased so it trails a little.
      const avatar = document.querySelector("[data-avatar-tilt]");
      if (
        avatar instanceof HTMLElement &&
        !reducedMotion.matches &&
        window.matchMedia("(hover: hover) and (pointer: fine)").matches
      ) {
        const hero = avatar.closest(".hero-section");
        let target = { x: 0, y: 0 };
        let current = { x: 0, y: 0 };
        let frame = 0;

        const step = () => {
          current.x += (target.x - current.x) * 0.12;
          current.y += (target.y - current.y) * 0.12;
          avatar.style.transform = `perspective(900px) rotateX(${current.y.toFixed(2)}deg) rotateY(${current.x.toFixed(2)}deg)`;
          const settled =
            Math.abs(target.x - current.x) < 0.01 && Math.abs(target.y - current.y) < 0.01;
          frame = settled ? 0 : window.requestAnimationFrame(step);
        };

        const queue = () => {
          if (!frame) frame = window.requestAnimationFrame(step);
        };

        hero?.addEventListener("pointermove", (event) => {
          const rect = avatar.getBoundingClientRect();
          const x = (event.clientX - (rect.left + rect.width / 2)) / window.innerWidth;
          const y = (event.clientY - (rect.top + rect.height / 2)) / window.innerHeight;
          target = { x: Math.max(-1, Math.min(1, x)) * 10, y: Math.max(-1, Math.min(1, -y)) * 10 };
          queue();
        });

        hero?.addEventListener("pointerleave", () => {
          target = { x: 0, y: 0 };
          queue();
        });
      }
    </script>
