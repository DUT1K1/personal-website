---
import { getCollection, render } from "astro:content";
import SiteHeader from "../../components/SiteHeader.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { formatTag } from "../../utils/tags.js";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const georgianPosts = await getCollection("blogKa", ({ data }) => !data.draft);
  const georgianIds = new Set(georgianPosts.map((post) => post.id.replace(/\.mdx?$/, "")));

  return posts.map((post) => {
    const slug = post.id.replace(/\.mdx?$/, "");
    return { params: { slug }, props: { post, hasGeorgianVersion: georgianIds.has(slug) } };
  });
}

const { post, hasGeorgianVersion } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const withBase = (path = "") => `${base}${path}`;
const postBody = post.body ?? "";
const readingTime = Math.max(
  1,
  Math.ceil(postBody.split(/\s+/).filter(Boolean).length / 200)
);
const authorName = post.data.author ?? "Davit Maisuradze";
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const seoTitle = post.data.seoTitle ?? `${post.data.title} | Davit Maisuradze`;
const seoDescription = post.data.seoDescription ?? post.data.description;
const canonicalUrl = post.data.canonical
  ? new URL(post.data.canonical)
  : new URL(Astro.url.pathname, siteUrl);
const slug = post.id.replace(/\.mdx?$/, "");
const georgianUrl = new URL(`/ka/blog/${slug}/`, siteUrl);
const alternates = hasGeorgianVersion
  ? [
      { hreflang: "en", href: canonicalUrl },
      { hreflang: "ka", href: georgianUrl },
      { hreflang: "x-default", href: canonicalUrl },
    ]
  : [{ hreflang: "en", href: canonicalUrl }, { hreflang: "x-default", href: canonicalUrl }];
const homepageUrl = new URL("/", siteUrl);
const blogUrl = new URL("/blog/", siteUrl);
const socialImagePath =
  post.data.image ?? withBase("resources/images/davit-maisuradze-social-card.png");
const socialImageUrl = new URL(socialImagePath, siteUrl);
const socialImageAlt =
  post.data.imageAlt ?? `${post.data.title}, an article by Davit Maisuradze`;
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalUrl.href}#article`,
  url: canonicalUrl.href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl.href,
  },
  headline: post.data.title,
  description: seoDescription,
  inLanguage: "en",
  image: [socialImageUrl.href],
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    "@type": "Person",
    "@id": `${homepageUrl.href}#davit-maisuradze`,
    name: authorName,
    url: homepageUrl.href,
    sameAs: [
      "https://www.linkedin.com/in/david-maisuradze2004/",
      "https://github.com/DUT1K1",
    ],
  },
  keywords: post.data.tags,
  isPartOf: {
    "@type": "Blog",
    "@id": `${blogUrl.href}#blog`,
    name: "Davit Maisuradze Blog",
    url: blogUrl.href,
  },
};
const articleBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: homepageUrl.href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: blogUrl.href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: canonicalUrl.href,
    },
  ],
};

const formatDate = (date) =>
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
---

<BlogLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  image={socialImageUrl}
  imageAlt={socialImageAlt}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={post.data.tags}
  noindex={post.data.noindex}
  structuredData={[articleStructuredData, articleBreadcrumbs]}
  alternates={alternates}
  alternateLocales={hasGeorgianVersion ? ["ka_GE"] : []}
>
  <SiteHeader currentPath="/blog" alternateHref={hasGeorgianVersion ? georgianUrl.pathname : undefined} />

  <main id="main-content" class="blog-shell">
    <section class="container blog-post-shell">
      <a href={withBase("blog/")} class="back-link">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Back to all posts
      </a>

      <section class="blog-post-top">
        <div class="blog-post-header">
          <div class="blog-post-heading">
            <p class="blog-eyebrow">Article</p>
            <h1 transition:name="post-heading">{post.data.title}</h1>
            <p class="blog-post-description">{post.data.description}</p>
          </div>
        </div>

        <aside class="blog-post-aside">
          <div class="blog-post-author">
            <img
              src={withBase("resources/images/prof-pic-160.webp")}
              alt={`${authorName} portrait`}
              class="blog-post-author-avatar"
              loading="lazy"
            />
            <div>
              <p class="blog-post-author-label">Written by</p>
              <p class="blog-post-author-name">{authorName}</p>
            </div>
          </div>

          <div class="blog-post-stat-grid">
            <div class="blog-post-stat">
              <span class="blog-post-stat-label">Published</span>
              <span class="blog-post-stat-value">{formatDate(post.data.pubDate)}</span>
            </div>

            {post.data.updatedDate ? (
              <div class="blog-post-stat">
                <span class="blog-post-stat-label">Updated</span>
                <span class="blog-post-stat-value">{formatDate(post.data.updatedDate)}</span>
              </div>
            ) : null}

            <div class="blog-post-stat">
              <span class="blog-post-stat-label">Reading time</span>
              <span class="blog-post-stat-value">{readingTime} min read</span>
            </div>
          </div>

          <div class="blog-card-tags blog-post-tags">
            {post.data.tags.map((tag) => (
              <a href={`${withBase("blog/")}?tag=${encodeURIComponent(tag)}`} class="blog-card-tag">
                {formatTag(tag, "en")}
              </a>
            ))}
          </div>
        </aside>
      </section>

      <article class="blog-post-content-card">
        <div class="blog-post-content">
          <Content />
        </div>
      </article>
    </section>
  </main>
</BlogLayout>
