---
import { frames, getSteps } from "../data/call-stack";

const { locale = "en" } = Astro.props;
const isGeorgian = locale === "ka";
const steps = getSteps(locale);

const copy = isGeorgian
  ? {
      eyebrow: "იმავე სტეკის 3D ვერსია",
      heading: "გამოძახების სტეკი სივრცეში",
      hint: "დაატრიალეთ გადათრევით. ჩარჩოზე დაჭერით იმ ნაბიჯზე გადახტებით, სადაც ის სტეკს დაემატა.",
      loading: "3D სცენა იტვირთება…",
      previous: "წინა",
      next: "შემდეგი",
      play: "დაკვრა",
      pause: "პაუზა",
      step: "ნაბიჯი",
      of: "/",
      depth: "სიღრმე",
      showPrevious: "წინა ნაბიჯზე გადასვლა",
      showNext: "შემდეგ ნაბიჯზე გადასვლა",
      toggleLabel: "ნაბიჯების ავტომატური დაკვრა",
      regionLabel: "გამოძახების სტეკის სამგანზომილებიანი ვიზუალიზაცია",
      legend: ["მუშაობს", "ელოდება", "აბრუნებს", "აგრძელებს მუშაობას"],
      top: "სტეკის წვერო",
      base: "სტეკის ძირი",
    }
  : {
      eyebrow: "The same stack in 3D",
      heading: "A call stack you can turn around",
      hint: "Drag to orbit. Click any frame to jump to the step that pushed it.",
      loading: "Loading the 3D scene…",
      previous: "Previous",
      next: "Next",
      play: "Play",
      pause: "Pause",
      step: "Step",
      of: "of",
      depth: "Depth",
      showPrevious: "Show previous step",
      showNext: "Show next step",
      toggleLabel: "Play the steps automatically",
      regionLabel: "Three-dimensional visualisation of the call stack",
      legend: ["Running", "Waiting", "Returning", "Resuming"],
      top: "Top of stack",
      base: "Stack base",
    };

const strings = isGeorgian
  ? {
      running: "მუშაობს",
      waiting: "ელოდება",
      returns: "აბრუნებს",
      receives: "იღებს",
      received: "მიიღო",
      finished: "დასრულდა",
      phaseCall: "ფუნქციების გამოძახება",
      phaseReturn: "მნიშვნელობების დაბრუნება",
      phaseComplete: "სტეკი დასრულებულია",
      depth: copy.depth,
      top: copy.top,
      base: copy.base,
    }
  : {
      running: "running",
      waiting: "waiting",
      returns: "returns",
      receives: "receives",
      received: "received",
      finished: "finished",
      phaseCall: "Calling functions",
      phaseReturn: "Returning values",
      phaseComplete: "Stack complete",
      depth: copy.depth,
      top: copy.top,
      base: copy.base,
    };

const sceneData = { locale, frames, steps, strings };
---

<section
  class:list={["call-stack-scene", { "is-georgian": isGeorgian }]}
  data-call-stack-scene
  role="region"
  aria-label={copy.regionLabel}
  tabindex="0"
  hidden
>
  <script type="application/json" data-scene-data set:html={JSON.stringify(sceneData)}></script>

  <header class="scene-header">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.heading}</h2>
    </div>
    <p class="hint">{copy.hint}</p>
  </header>

  <div class="scene-stage" data-scene-stage>
    <canvas data-scene-canvas aria-hidden="true"></canvas>
    <div class="scene-hud" aria-hidden="true">
      <span class="phase" data-scene-phase></span>
      <span class="depth" data-scene-depth></span>
    </div>
    <p class="scene-loading" data-scene-loading>{copy.loading}</p>
    <div class="scene-tooltip" data-scene-tooltip aria-hidden="true" hidden></div>
  </div>

  <p class="scene-caption" data-scene-caption aria-live="polite" aria-atomic="true">
    <strong data-scene-title></strong><span data-scene-description></span>
  </p>

  <div class="legend" aria-hidden="true">
    <span><i class="running"></i>{copy.legend[0]}</span>
    <span><i class="waiting"></i>{copy.legend[1]}</span>
    <span><i class="returning"></i>{copy.legend[2]}</span>
    <span><i class="resuming"></i>{copy.legend[3]}</span>
  </div>

  <div class="controls">
    <button type="button" data-scene-previous aria-label={copy.showPrevious} disabled>
      <span aria-hidden="true">&#8592;</span> <span class="button-label">{copy.previous}</span>
    </button>
    <div class="controls-center">
      <button
        type="button"
        class="play"
        data-scene-toggle
        aria-label={copy.toggleLabel}
        aria-pressed="false"
        data-label-play={copy.play}
        data-label-pause={copy.pause}
      >
        <span aria-hidden="true" data-scene-toggle-icon>&#9654;</span>
        <span class="button-label" data-scene-toggle-label>{copy.play}</span>
      </button>
      <p>{copy.step} <span data-scene-current>1</span> {copy.of} {steps.length}</p>
    </div>
    <button type="button" data-scene-next aria-label={copy.showNext}>
      <span class="button-label">{copy.next}</span> <span aria-hidden="true">&#8594;</span>
    </button>
  </div>

  <div class="progress" aria-hidden="true" data-scene-track data-direction="forward">
    {steps.map((_, index) => (
      <span class:list={[{ "is-active": index === 0 }, { "is-current": index === 0 }]} data-scene-progress></span>
    ))}
  </div>
</section>

<script>
  import { createActorKit, FRAME_VALUES } from "../utils/call-stack-actors.js";

  // The 3D twin of the DOM diagram above. Same steps, same palette, but the
  // stack is a real object: it can be orbited, hovered and jumped into.
  const STATE_STYLES = {
    idle: { color: "#2b2724", emissive: "#000000", intensity: 0, label: "#8d857f", opacity: 0.55 },
    waiting: { color: "#20374f", emissive: "#0b1c33", intensity: 0.12, label: "#a9d4ff", opacity: 1 },
    active: { color: "#ff8660", emissive: "#ff5a28", intensity: 0.32, label: "#fff4ef", opacity: 1 },
    returning: { color: "#65d3a0", emissive: "#188f63", intensity: 0.3, label: "#e7fff3", opacity: 1 },
    receiving: { color: "#7db7ff", emissive: "#2b68bd", intensity: 0.2, label: "#eaf5ff", opacity: 1 },
    complete: { color: "#9a33ff", emissive: "#5c17a8", intensity: 0.32, label: "#f1e4ff", opacity: 1 },
  };

  // Each frame's character gets a motion that suits it. The rigs themselves
  // animate their own parts; this only moves the whole character.
  const MOTIONS = [
    { name: "story", motion: "steady" },
    { name: "ant", motion: "fall" },
    { name: "flea", motion: "hop" },
    { name: "rope", motion: "twist" },
    { name: "pig", motion: "waddle" },
    { name: "acorn", motion: "drop" },
    { name: "crow", motion: "flutter" },
    { name: "chick", motion: "hop" },
    { name: "millet", motion: "sway" },
    { name: "mouse", motion: "scurry" },
    { name: "cat", motion: "settle" },
    { name: "cow", motion: "settle" },
  ];

  const TWO_PI = Math.PI * 2;

  // Offsets applied to the whole character; the rig's own update() handles the
  // limbs, wings and tails.
  const MOVES = {
    steady: (t) => ({ dy: Math.sin(t * 1.4) * 0.05 }),
    settle: () => ({}),
    hop: (t) => ({ dy: Math.abs(Math.sin(t * 3.4)) * 0.3 }),
    fall: (t) => {
      const cycle = (t * 0.55) % 1;
      return { dy: 0.55 - cycle * 1.15, spin: cycle * 2.2 };
    },
    drop: (t) => ({ dy: 0.5 - ((t * 0.8) % 1) * 1.05 }),
    twist: (t) => ({ dy: Math.sin(t * 1.8) * 0.06 }),
    waddle: (t) => ({ spin: Math.sin(t * 3.1) * 0.12, dy: Math.abs(Math.sin(t * 3.1)) * 0.05 }),
    flutter: (t) => ({ dy: Math.sin(t * 4.6) * 0.14, dx: Math.sin(t * 1.5) * 0.12 }),
    sway: (t) => ({ spin: Math.sin(t * 1.7) * 0.1 }),
    scurry: (t) => ({ dx: Math.sin(t * 2.4) * 0.4, turn: Math.cos(t * 2.4) > 0 ? 0 : Math.PI }),
  };

  const ACTOR_X = 2.5;
  const ACTOR_TURN = 0.45;

  const FRAME_W = 3.3;
  const FRAME_D = 1.25;
  const FRAME_H = 0.5;
  const SLOT = FRAME_H + 0.1;
  const BASE_H = 0.26;
  const LABEL_W = 1024;
  const LABEL_H = 128;
  const AUTOPLAY_MS = 1500;

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
  const damp = (current, target, lambda, dt) =>
    current + (target - current) * (1 - Math.exp(-lambda * dt));

  const stateOf = (step, index) => {
    if (step.phase === "complete" && index === 0) return "complete";
    if (index === step.returning) return "returning";
    if (index === step.receiving) return "receiving";
    if (index === step.active) return "active";
    if (index < step.active) return "waiting";
    return "idle";
  };

  const stateTextOf = (step, index, words) => {
    if (step.phase === "complete" && index === 0) return words.finished;
    if (index === step.returning) return words.returns + ": " + step.value;
    if (index === step.receiving) return words.receives + ": " + step.value;
    if (index === step.active && step.received) return words.received + ": " + step.received;
    if (index === step.active && step.phase === "call") return words.running;
    if (index < step.active) return words.waiting;
    return "";
  };

  // Shrinks the text until it fits, then ellipsises whatever still overflows.
  const fitText = (ctx, text, maxWidth, weight, size, minSize, family) => {
    let current = size;
    ctx.font = weight + " " + current + "px " + family;
    while (ctx.measureText(text).width > maxWidth && current > minSize) {
      current -= 2;
      ctx.font = weight + " " + current + "px " + family;
    }
    if (ctx.measureText(text).width <= maxWidth) return text;

    let trimmed = text;
    while (trimmed.length > 1 && ctx.measureText(trimmed + "…").width > maxWidth) {
      trimmed = trimmed.slice(0, -1);
    }
    return trimmed + "…";
  };

  const initScene = async (section) => {
    if (section.dataset.sceneReady) return;
    section.dataset.sceneReady = "true";

    const stage = section.querySelector("[data-scene-stage]");
    const canvas = section.querySelector("[data-scene-canvas]");
    const dataNode = section.querySelector("[data-scene-data]");
    if (!stage || !canvas || !dataNode) return;

    const { frames, steps, strings, locale } = JSON.parse(dataNode.textContent || "{}");
    const latinFamily = '"Poppins", system-ui, sans-serif';
    const stateFamily =
      locale === "ka" ? '"Noto Sans Georgian", "Poppins", sans-serif' : latinFamily;

    const loading = section.querySelector("[data-scene-loading]");
    const tooltip = section.querySelector("[data-scene-tooltip]");
    const phaseBadge = section.querySelector("[data-scene-phase]");
    const depthBadge = section.querySelector("[data-scene-depth]");
    const titleNode = section.querySelector("[data-scene-title]");
    const descriptionNode = section.querySelector("[data-scene-description]");
    const currentNode = section.querySelector("[data-scene-current]");
    const previousButton = section.querySelector("[data-scene-previous]");
    const nextButton = section.querySelector("[data-scene-next]");
    const toggleButton = section.querySelector("[data-scene-toggle]");
    const toggleIcon = section.querySelector("[data-scene-toggle-icon]");
    const toggleLabel = section.querySelector("[data-scene-toggle-label]");
    const progressTrack = section.querySelector("[data-scene-track]");
    const progress = Array.from(section.querySelectorAll("[data-scene-progress]"));

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let THREE;
    try {
      THREE = await import("three");
    } catch {
      section.hidden = true;
      return;
    }

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: window.devicePixelRatio < 2,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(new THREE.Color("#0b0a09"), 14, 38);

    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 120);
    const cameraTarget = new THREE.Vector3(0, 1.4, 0);
    const focus = { y: 1.4, radius: 9 };
    const HOME_AZIMUTH = 0.45;
    const orbit = { azimuth: HOME_AZIMUTH, polar: 1.1, radius: 9 };
    const orbitTarget = { azimuth: HOME_AZIMUTH, polar: 1.1 };
    let sway = 0;
    // Set once the reader drags: their chosen angle then outranks the idle sway.
    let userOriented = false;

    scene.add(new THREE.AmbientLight(new THREE.Color("#cfd8e6"), 0.75));

    const keyLight = new THREE.DirectionalLight(new THREE.Color("#ffffff"), 2.3);
    keyLight.position.set(5, 9, 6);
    scene.add(keyLight);

    const rimLight = new THREE.PointLight(new THREE.Color("#5badff"), 14, 26, 2);
    rimLight.position.set(-6, 3, -5);
    scene.add(rimLight);

    // Follows whichever frame is currently doing the work, so the running
    // frame visibly lights the frames waiting beneath it.
    const focusLight = new THREE.PointLight(new THREE.Color("#ff8660"), 5, 12, 2);
    scene.add(focusLight);

    const roundedRect = (width, depth, radius) => {
      const shape = new THREE.Shape();
      const x = width / 2;
      const y = depth / 2;
      shape.moveTo(-x + radius, -y);
      shape.lineTo(x - radius, -y);
      shape.quadraticCurveTo(x, -y, x, -y + radius);
      shape.lineTo(x, y - radius);
      shape.quadraticCurveTo(x, y, x - radius, y);
      shape.lineTo(-x + radius, y);
      shape.quadraticCurveTo(-x, y, -x, y - radius);
      shape.lineTo(-x, -y + radius);
      shape.quadraticCurveTo(-x, -y, -x + radius, -y);
      return shape;
    };

    // Extruding a rounded outline keeps the slabs soft-edged without pulling in
    // RoundedBoxGeometry from three/examples.
    const slabGeometry = (width, depth, height, radius) => {
      const geometry = new THREE.ExtrudeGeometry(roundedRect(width, depth, radius), {
        depth: height,
        bevelEnabled: true,
        bevelThickness: 0.025,
        bevelSize: 0.025,
        bevelSegments: 2,
        curveSegments: 5,
      });
      geometry.rotateX(-Math.PI / 2);
      geometry.center();
      return geometry;
    };

    const frameGeometry = slabGeometry(FRAME_W, FRAME_D, FRAME_H, 0.1);
    frameGeometry.computeBoundingBox();
    const frameFront = frameGeometry.boundingBox.max.z;
    const labelWidth = FRAME_W - 0.22;
    const labelGeometry = new THREE.PlaneGeometry(labelWidth, (labelWidth * LABEL_H) / LABEL_W);

    const baseGeometry = slabGeometry(FRAME_W + 1, FRAME_D + 0.7, BASE_H, 0.16);
    const base = new THREE.Mesh(
      baseGeometry,
      new THREE.MeshStandardMaterial({
        color: new THREE.Color("#17161a"),
        roughness: 0.75,
        metalness: 0.2,
      }),
    );
    base.position.y = -BASE_H / 2;
    scene.add(base);

    const grid = new THREE.GridHelper(30, 30, new THREE.Color("#5badff"), new THREE.Color("#332e2a"));
    grid.material.transparent = true;
    grid.material.opacity = 0.16;
    grid.position.y = -BASE_H - 0.001;
    scene.add(grid);

    const maxAnisotropy = renderer.capabilities.getMaxAnisotropy();

    const makeTexture = () => {
      const element = document.createElement("canvas");
      element.width = LABEL_W;
      element.height = LABEL_H;
      const texture = new THREE.CanvasTexture(element);
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.anisotropy = maxAnisotropy;
      return { element, texture };
    };

    const drawFrameLabel = (entry) => {
      const ctx = entry.element.getContext("2d");
      ctx.clearRect(0, 0, LABEL_W, LABEL_H);
      ctx.textBaseline = "middle";
      ctx.fillStyle = "#ffffff";

      const nameLeft = 26;
      const name = fitText(ctx, entry.name, LABEL_W * 0.5, "600", 74, 44, latinFamily);
      ctx.textAlign = "left";
      ctx.fillStyle = "#ffffff";
      ctx.fillText(name, nameLeft, LABEL_H / 2);
      const nameWidth = nameLeft + ctx.measureText(name).width;

      if (entry.state) {
        const room = LABEL_W - nameWidth - 60;
        const state = fitText(ctx, entry.state, room, "600", 56, 28, stateFamily);
        ctx.textAlign = "right";
        ctx.globalAlpha = 0.92;
        ctx.fillText(state, LABEL_W - 26, LABEL_H / 2);
        ctx.globalAlpha = 1;
      }

      entry.texture.needsUpdate = true;
    };

    const drawEdgeLabel = (entry) => {
      const ctx = entry.element.getContext("2d");
      ctx.clearRect(0, 0, LABEL_W, LABEL_H);
      ctx.textBaseline = "middle";
      ctx.textAlign = "center";
      ctx.fillStyle = "#8d857f";
      const text = fitText(ctx, entry.name, LABEL_W - 40, "700", 86, 40, stateFamily);
      ctx.fillText(text, LABEL_W / 2, LABEL_H / 2);
      entry.texture.needsUpdate = true;
    };

    const slots = frames.map((name, index) => {
      const material = new THREE.MeshStandardMaterial({
        color: new THREE.Color(STATE_STYLES.idle.color),
        emissive: new THREE.Color(STATE_STYLES.idle.emissive),
        emissiveIntensity: 0,
        roughness: 0.42,
        metalness: 0.22,
        transparent: true,
        opacity: 0,
      });
      const mesh = new THREE.Mesh(frameGeometry, material);
      mesh.visible = false;
      mesh.userData.index = index;

      const label = makeTexture();
      label.name = name;
      label.state = "";
      const labelMaterial = new THREE.MeshBasicMaterial({
        map: label.texture,
        transparent: true,
        depthWrite: false,
        opacity: 0,
      });
      const frontLabel = new THREE.Mesh(labelGeometry, labelMaterial);
      frontLabel.position.z = frameFront + 0.006;
      frontLabel.renderOrder = 2;
      mesh.add(frontLabel);

      const backLabel = new THREE.Mesh(labelGeometry, labelMaterial);
      backLabel.position.z = -frameFront - 0.006;
      backLabel.rotation.y = Math.PI;
      backLabel.renderOrder = 2;
      mesh.add(backLabel);

      drawFrameLabel(label);

      scene.add(mesh);

      const restY = FRAME_H / 2 + index * SLOT;
      return {
        index,
        name,
        mesh,
        material,
        labelMaterial,
        label,
        restY,
        state: "idle",
        present: false,
        opacity: 0,
        lift: 0,
        glow: 0,
        color: new THREE.Color(STATE_STYLES.idle.color),
        emissive: new THREE.Color(STATE_STYLES.idle.emissive),
        intensity: 0,
      };
    });

    const edgeEntries = [];
    const edgeLabel = (text, width) => {
      const entry = makeTexture();
      entry.name = text;
      drawEdgeLabel(entry);
      edgeEntries.push(entry);
      const geometry = new THREE.PlaneGeometry(width, (width * LABEL_H) / LABEL_W);
      const mesh = new THREE.Mesh(
        geometry,
        new THREE.MeshBasicMaterial({
          map: entry.texture,
          transparent: true,
          depthWrite: false,
          opacity: 0.85,
        }),
      );
      scene.add(mesh);
      return mesh;
    };

    const topLabel = edgeLabel(strings.top, 2.1);
    const baseLabel = edgeLabel(strings.base, 2.1);
    baseLabel.position.set(0, -BASE_H - 0.42, 0);

    const kit = createActorKit(THREE);

    // Rigs are built the first time a character is needed and then kept, so
    // stepping back and forth never rebuilds them.
    const rigs = new Map();
    const rigFor = (name) => {
      if (!name) return null;
      const cached = rigs.get(name);
      if (cached !== undefined) return cached;
      const built = kit.build(name);
      if (built) {
        built.group.visible = false;
        scene.add(built.group);
      }
      rigs.set(name, built);
      return built;
    };

    // The character beside the running frame, acting out what that function is
    // doing while the frames below it wait.
    const actorState = { name: "", rig: null, clock: 0, opacity: 0, y: 0 };
    const actorLight = new THREE.PointLight(new THREE.Color("#ffd9c2"), 0, 5, 2);
    scene.add(actorLight);

    const setOpacity = (root, opacity) => {
      root.traverse((node) => {
        if (!node.material) return;
        node.material.transparent = opacity < 0.999;
        node.material.opacity = opacity;
      });
    };

    const PARTICLE_COUNT = 20;
    const particles = Array.from({ length: PARTICLE_COUNT }, () => {
      const mesh = new THREE.Mesh(
        kit.shard("shard"),
        new THREE.MeshStandardMaterial({ roughness: 0.5, transparent: true, opacity: 0 }),
      );
      mesh.visible = false;
      scene.add(mesh);
      return { mesh, life: 0, span: 1, velocity: new THREE.Vector3(), spin: new THREE.Vector3(), size: 0.05 };
    });

    // Whatever the character kicks up: water where the ant falls, feathers for
    // the crow, milk droplets for the cat.
    const burst = (name, origin, count, spread) => {
      if (reducedMotion.matches || !name) return;
      const spec = kit.dust(name);
      const geometry = kit.shard(spec.shape);
      const color = kit.colorOf(spec.color);
      let spawned = 0;
      for (const particle of particles) {
        if (spawned >= count) break;
        if (particle.life > 0) continue;
        spawned += 1;
        particle.mesh.geometry = geometry;
        particle.mesh.material.color.setStyle(color);
        particle.mesh.position.copy(origin);
        particle.mesh.visible = true;
        particle.span = 0.6 + Math.random() * 0.35;
        particle.life = particle.span;
        particle.size = 0.035 + Math.random() * 0.035;
        particle.spin.set(Math.random() * 4 - 2, Math.random() * 4 - 2, Math.random() * 4 - 2);
        const angle = Math.random() * TWO_PI;
        particle.velocity.set(
          Math.cos(angle) * spread * (0.4 + Math.random() * 0.7),
          0.7 + Math.random() * 0.6,
          Math.sin(angle) * spread * (0.4 + Math.random() * 0.7),
        );
      }
    };

    // The returned value travels down the stack as the thing itself, which is the
    // one part of the story the flat diagram can only describe in words.
    const orb = new THREE.Group();
    orb.visible = false;
    scene.add(orb);
    const orbLight = new THREE.PointLight(new THREE.Color("#65d3a0"), 0, 6, 2);
    scene.add(orbLight);
    const orbFlight = {
      active: false,
      time: 0,
      duration: 0.95,
      name: "",
      rig: null,
      from: new THREE.Vector3(),
      to: new THREE.Vector3(),
      control: new THREE.Vector3(),
    };

    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    let hovered = -1;
    let pointerInside = false;
    let dragging = false;
    let dragPointer = null;
    let dragMoved = 0;
    let lastX = 0;
    let lastY = 0;

    let active = 0;
    let playing = false;
    let playClock = 0;
    let running = false;
    let visible = false;
    let frameId = 0;
    let lastTime = 0;

    const fitRadius = () => {
      const step = steps[active];
      const height = Math.max(step.depth, 5) * SLOT + 1.7;
      const width = FRAME_W + 2;
      const vFov = (camera.fov * Math.PI) / 180;
      const distanceV = height / 2 / Math.tan(vFov / 2);
      const hFov = 2 * Math.atan(Math.tan(vFov / 2) * camera.aspect);
      const distanceH = width / 2 / Math.tan(hFov / 2);
      return Math.max(distanceV, distanceH) * 1.1;
    };

    const applyStep = (index, direction) => {
      const step = steps[index];

      slots.forEach((slot) => {
        const present = slot.index < step.depth;
        const state = present ? stateOf(step, slot.index) : "idle";
        const style = STATE_STYLES[state];

        if (present && !slot.present) {
          // A newly pushed frame starts above its slot and drops in.
          slot.lift = reducedMotion.matches ? 0 : 2.6;
          slot.opacity = reducedMotion.matches ? style.opacity : 0;
        }

        slot.present = present;
        slot.state = state;
        slot.mesh.visible = present || slot.opacity > 0.01;

        const text = present ? stateTextOf(step, slot.index, strings) : "";
        if (slot.label.state !== text) {
          slot.label.state = text;
          drawFrameLabel(slot.label);
        }
      });

      focus.y = BASE_H + (step.depth * SLOT) / 2;
      focus.radius = fitRadius();

      if (phaseBadge) {
        phaseBadge.textContent =
          step.phase === "call"
            ? strings.phaseCall
            : step.phase === "return"
              ? strings.phaseReturn
              : strings.phaseComplete;
        phaseBadge.dataset.phase = step.phase;
      }
      if (depthBadge) depthBadge.textContent = strings.depth + " " + step.depth;
      if (titleNode) titleNode.textContent = step.title;
      if (descriptionNode) descriptionNode.textContent = step.description;
      if (currentNode) currentNode.textContent = String(index + 1);
      if (progressTrack) progressTrack.dataset.direction = direction < 0 ? "back" : "forward";
      progress.forEach((item, itemIndex) => {
        item.classList.toggle("is-active", itemIndex <= index);
        item.classList.toggle("is-current", itemIndex === index);
      });
      if (previousButton) previousButton.disabled = index === 0;
      if (nextButton) nextButton.disabled = index === steps.length - 1;

      // The character changes whenever the running frame does, and restarts
      // its motion from the beginning of the cycle.
      const entry = MOTIONS[step.active];
      if (entry && actorState.name !== entry.name) {
        if (actorState.rig) actorState.rig.group.visible = false;
        actorState.name = entry.name;
        actorState.rig = rigFor(entry.name);
        actorState.clock = 0;
        actorState.opacity = 0;
        if (actorState.rig) {
          actorState.rig.group.visible = true;
          actorState.rig.group.position.set(ACTOR_X, slots[step.active].restY + 0.2, 0.1);
        }
        if (direction > 0) {
          burst(entry.name, new THREE.Vector3(ACTOR_X, slots[step.active].restY + 0.2, 0.1), 5, 0.7);
        }
      }

      if (
        direction > 0 &&
        step.value &&
        typeof step.returning === "number" &&
        typeof step.receiving === "number" &&
        !reducedMotion.matches
      ) {
        const from = slots[step.returning];
        const to = slots[step.receiving];
        const lane = FRAME_D / 2 + 0.55;
        orbFlight.from.set(0, from.restY + FRAME_H * 0.6, lane);
        orbFlight.to.set(0, to.restY + FRAME_H * 0.6, lane);
        orbFlight.control.set(0, (from.restY + to.restY) / 2 + FRAME_H, lane + 1.5);
        orbFlight.active = true;
        orbFlight.time = 0;
        orb.visible = true;

        const name = FRAME_VALUES[step.returning];
        if (orbFlight.rig) orbFlight.rig.group.visible = false;
        orbFlight.name = name;
        orbFlight.rig = rigFor(name);
        orbLight.color.setStyle(kit.colorOf(kit.dust(name).color));
        if (orbFlight.rig) {
          orbFlight.rig.group.visible = true;
          orb.add(orbFlight.rig.group);
          orbFlight.rig.group.position.set(0, 0, 0);
          orbFlight.rig.group.scale.setScalar(0.8);
        }
      }
    };

    const show = (requested, direction) => {
      const next = clamp(requested, 0, steps.length - 1);
      if (next === active) return;
      const way = direction ?? (next > active ? 1 : -1);
      active = next;
      applyStep(active, way);
      if (active === steps.length - 1) setPlaying(false);
    };

    const setPlaying = (value) => {
      playing = value;
      playClock = 0;
      if (!toggleButton) return;
      toggleButton.setAttribute("aria-pressed", value ? "true" : "false");
      if (toggleIcon) toggleIcon.textContent = value ? "❚❚" : "▶";
      if (toggleLabel) {
        toggleLabel.textContent = value
          ? toggleButton.dataset.labelPause
          : toggleButton.dataset.labelPlay;
      }
    };

    const resize = () => {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      if (!width || !height) return;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      focus.radius = fitRadius();
    };

    const updateHover = () => {
      if (!pointerInside || dragging) {
        if (hovered !== -1) {
          hovered = -1;
          if (tooltip) tooltip.hidden = true;
          canvas.style.cursor = "grab";
        }
        return;
      }

      raycaster.setFromCamera(pointer, camera);
      const targets = slots.filter((slot) => slot.present).map((slot) => slot.mesh);
      const hit = raycaster.intersectObjects(targets, false)[0];
      const index = hit ? hit.object.userData.index : -1;

      if (index !== hovered) {
        hovered = index;
        canvas.style.cursor = index === -1 ? "grab" : "pointer";
        if (tooltip) {
          if (index === -1) {
            tooltip.hidden = true;
          } else {
            const slot = slots[index];
            tooltip.hidden = false;
            tooltip.innerHTML = "";
            const name = document.createElement("strong");
            name.textContent = slot.name;
            tooltip.appendChild(name);
            if (slot.label.state) {
              const state = document.createElement("span");
              state.textContent = slot.label.state;
              tooltip.appendChild(state);
            }
          }
        }
      }
    };

    const tick = (time) => {
      frameId = requestAnimationFrame(tick);
      const dt = Math.min((time - lastTime) / 1000 || 0, 0.05);
      lastTime = time;

      if (playing) {
        playClock += dt * 1000;
        if (playClock >= AUTOPLAY_MS) {
          playClock = 0;
          if (active === steps.length - 1) setPlaying(false);
          else show(active + 1, 1);
        }
      }

      const settle = reducedMotion.matches ? 60 : 9;

      slots.forEach((slot) => {
        const style = STATE_STYLES[slot.state];
        const targetOpacity = slot.present ? style.opacity : 0;
        const targetLift = slot.present ? 0 : 2.2;
        const isHovered = hovered === slot.index;
        const targetGlow = isHovered ? 0.5 : 0;

        slot.opacity = damp(slot.opacity, targetOpacity, settle, dt);
        slot.lift = damp(slot.lift, targetLift, settle, dt);
        slot.glow = damp(slot.glow, targetGlow, 12, dt);
        slot.color.lerp(new THREE.Color(style.color), 1 - Math.exp(-settle * dt));
        slot.emissive.lerp(new THREE.Color(style.emissive), 1 - Math.exp(-settle * dt));
        slot.intensity = damp(slot.intensity, style.intensity + slot.glow, settle, dt);

        slot.material.color.copy(slot.color);
        slot.material.emissive.copy(slot.emissive);
        slot.material.emissiveIntensity = slot.intensity;
        slot.material.opacity = slot.opacity;
        slot.labelMaterial.opacity = slot.opacity;
        slot.labelMaterial.color.setStyle(style.label);
        slot.mesh.position.y = slot.restY + slot.lift;
        slot.mesh.scale.setScalar(0.94 + 0.06 * clamp(slot.opacity, 0, 1) + slot.glow * 0.03);
        slot.mesh.visible = slot.opacity > 0.01;
      });

      const step = steps[active];
      const lit = slots[Math.min(step.active, slots.length - 1)];
      focusLight.position.set(1.6, lit.restY + 0.9, 1.6);
      focusLight.color.setStyle(STATE_STYLES[lit.state]?.color || "#ff8660");

      // The character rides alongside the running frame, acting out its motion.
      if (actorState.rig) {
        const group = actorState.rig.group;
        actorState.clock += dt;
        const still = reducedMotion.matches;
        const entry = MOTIONS[step.active];
        const move = still ? {} : (MOVES[entry?.motion] || MOVES.settle)(actorState.clock);

        // The rig sits at the frame's height; the motion rides on top of it.
        actorState.y = damp(actorState.y, lit.restY + 0.2, 7, dt);
        group.position.set(ACTOR_X + (move.dx || 0), actorState.y + (move.dy || 0), 0.1);
        group.rotation.set(0, ACTOR_TURN + (move.turn || 0), move.spin || 0);

        actorState.opacity = damp(actorState.opacity, lit.opacity > 0.5 ? 1 : 0, 7, dt);
        setOpacity(group, actorState.opacity);
        group.visible = actorState.opacity > 0.02;
        if (!still) actorState.rig.update(actorState.clock);

        actorLight.position.set(ACTOR_X, actorState.y + 0.3, 0.6);
        actorLight.intensity = actorState.opacity * 2.6;
      }

      particles.forEach((particle) => {
        if (particle.life <= 0) return;
        particle.life -= dt;
        if (particle.life <= 0) {
          particle.mesh.visible = false;
          return;
        }
        particle.velocity.y -= dt * 4.2;
        particle.mesh.position.addScaledVector(particle.velocity, dt);
        const fraction = particle.life / particle.span;
        particle.mesh.scale.setScalar(particle.size * (0.5 + fraction * 0.7));
        particle.mesh.rotation.x += particle.spin.x * dt;
        particle.mesh.rotation.y += particle.spin.y * dt;
        particle.mesh.rotation.z += particle.spin.z * dt;
        particle.mesh.material.opacity = Math.min(1, fraction * 1.6);
      });

      topLabel.position.set(0, FRAME_H / 2 + (step.depth - 1) * SLOT + 0.85, 0);
      topLabel.quaternion.copy(camera.quaternion);
      baseLabel.quaternion.copy(camera.quaternion);

      if (orbFlight.active) {
        orbFlight.time += dt;
        const progressValue = clamp(orbFlight.time / orbFlight.duration, 0, 1);
        const eased = progressValue * progressValue * (3 - 2 * progressValue);
        const inverse = 1 - eased;
        orb.position.set(
          inverse * inverse * orbFlight.from.x + 2 * inverse * eased * orbFlight.control.x + eased * eased * orbFlight.to.x,
          inverse * inverse * orbFlight.from.y + 2 * inverse * eased * orbFlight.control.y + eased * eased * orbFlight.to.y,
          inverse * inverse * orbFlight.from.z + 2 * inverse * eased * orbFlight.control.z + eased * eased * orbFlight.to.z,
        );
        const fade = Math.sin(Math.PI * progressValue);
        setOpacity(orb, fade);
        orbLight.position.copy(orb.position);
        orbLight.intensity = fade * 6;
        orb.rotation.y += dt * 1.9;
        if (orbFlight.rig) orbFlight.rig.update(orbFlight.time);
        if (progressValue >= 1) {
          orbFlight.active = false;
          orb.visible = false;
          orbLight.intensity = 0;
          burst(orbFlight.name, orb.position.clone(), 6, 0.55);
        }
      }

      if (!dragging && !pointerInside && !userOriented && !reducedMotion.matches) {
        sway += dt;
        orbitTarget.azimuth = HOME_AZIMUTH + Math.sin(sway * 0.32) * 0.3;
      }

      orbit.azimuth = damp(orbit.azimuth, orbitTarget.azimuth, 6, dt);
      orbit.polar = damp(orbit.polar, orbitTarget.polar, 6, dt);
      orbit.radius = damp(orbit.radius, focus.radius, 4, dt);
      cameraTarget.y = damp(cameraTarget.y, focus.y, 4, dt);

      const sinPolar = Math.sin(orbit.polar);
      camera.position.set(
        cameraTarget.x + orbit.radius * sinPolar * Math.sin(orbit.azimuth),
        cameraTarget.y + orbit.radius * Math.cos(orbit.polar),
        cameraTarget.z + orbit.radius * sinPolar * Math.cos(orbit.azimuth),
      );
      camera.lookAt(cameraTarget);

      updateHover();
      renderer.render(scene, camera);
    };

    const start = () => {
      if (running) return;
      running = true;
      lastTime = performance.now();
      frameId = requestAnimationFrame(tick);
    };

    const stop = () => {
      if (!running) return;
      running = false;
      cancelAnimationFrame(frameId);
    };

    previousButton?.addEventListener("click", () => {
      setPlaying(false);
      show(active - 1, -1);
    });
    nextButton?.addEventListener("click", () => {
      setPlaying(false);
      show(active + 1, 1);
    });
    toggleButton?.addEventListener("click", () => {
      if (!playing && active === steps.length - 1) show(0, -1);
      setPlaying(!playing);
    });

    section.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      setPlaying(false);
      show(active + (event.key === "ArrowRight" ? 1 : -1));
    });

    const pointerPosition = (event) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      if (tooltip) {
        const margin = 84;
        tooltip.style.left = clamp(event.clientX - rect.left, margin, rect.width - margin) + "px";
        tooltip.style.top = Math.max(event.clientY - rect.top, 64) + "px";
      }
    };

    canvas.addEventListener("pointerenter", () => {
      pointerInside = true;
    });
    canvas.addEventListener("pointerleave", () => {
      pointerInside = false;
    });
    canvas.addEventListener("pointerdown", (event) => {
      if (dragPointer !== null) return;
      dragPointer = event.pointerId;
      dragging = true;
      dragMoved = 0;
      lastX = event.clientX;
      lastY = event.clientY;
      pointerPosition(event);
      canvas.setPointerCapture(event.pointerId);
      canvas.style.cursor = "grabbing";
    });
    canvas.addEventListener("pointermove", (event) => {
      pointerPosition(event);
      if (dragPointer !== event.pointerId) return;
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      dragMoved += Math.abs(dx) + Math.abs(dy);
      if (dragMoved > 6) userOriented = true;
      orbitTarget.azimuth -= dx * 0.006;
      // Touch keeps its vertical axis for page scrolling, so only a mouse or
      // pen may change the elevation.
      if (event.pointerType !== "touch") {
        orbitTarget.polar = clamp(orbitTarget.polar - dy * 0.005, 0.42, 1.42);
      }
    });

    const endDrag = (event) => {
      if (dragPointer !== event.pointerId) return;
      dragPointer = null;
      dragging = false;
      canvas.style.cursor = "grab";
      if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
      // A short press is a click: jump to the step that pushed this frame.
      if (dragMoved < 6) {
        raycaster.setFromCamera(pointer, camera);
        const targets = slots.filter((slot) => slot.present).map((slot) => slot.mesh);
        const hit = raycaster.intersectObjects(targets, false)[0];
        if (hit) {
          setPlaying(false);
          show(hit.object.userData.index);
        }
      }
    };

    canvas.addEventListener("pointerup", endDrag);
    canvas.addEventListener("pointercancel", endDrag);

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(stage);

    // Nothing renders while the scene is off screen; a blog page should not
    // spin the GPU in the background.
    const visibility = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          visible = entry.isIntersecting;
          if (visible) start();
          else {
            stop();
            setPlaying(false);
          }
        });
      },
      { threshold: 0.05 },
    );
    visibility.observe(section);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else if (visible) start();
    });

    reducedMotion.addEventListener?.("change", () => {
      if (reducedMotion.matches) setPlaying(false);
    });

    resize();
    applyStep(0, 1);
    setPlaying(false);
    canvas.style.cursor = "grab";
    section.dataset.sceneLive = "true";
    if (loading) loading.remove();
    start();

    // Canvas text is measured before the webfont lands, so redraw once it has.
    document.fonts?.ready
      .then(() => {
        slots.forEach((slot) => drawFrameLabel(slot.label));
        edgeEntries.forEach(drawEdgeLabel);
      })
      .catch(() => {});

    const dispose = () => {
      stop();
      resizeObserver.disconnect();
      visibility.disconnect();
      renderer.dispose();
      frameGeometry.dispose();
      labelGeometry.dispose();
      baseGeometry.dispose();
      kit.dispose();
      particles.forEach((particle) => particle.mesh.material.dispose());
      slots.forEach((slot) => {
        slot.material.dispose();
        slot.labelMaterial.dispose();
        slot.label.texture.dispose();
      });
    };

    document.addEventListener("astro:before-swap", dispose, { once: true });
  };

  const webglSupported = () => {
    try {
      const probe = document.createElement("canvas");
      return Boolean(probe.getContext("webgl2") || probe.getContext("webgl"));
    } catch {
      return false;
    }
  };

  const setupScenes = () => {
    document.querySelectorAll("[data-call-stack-scene]").forEach((section) => {
      if (section.dataset.sceneBoot) return;
      section.dataset.sceneBoot = "true";
      if (!webglSupported()) return;

      section.hidden = false;
      // three.js is a separate chunk, fetched only once the reader arrives.
      const loader = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            loader.disconnect();
            void initScene(section);
          });
        },
        { rootMargin: "320px 0px" },
      );
      loader.observe(section);
    });
  };

  setupScenes();
  document.addEventListener("astro:page-load", setupScenes);
</script>

