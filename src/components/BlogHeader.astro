---
const { currentPath = "/" } = Astro.props;
const isHome = currentPath === "/";
const isBlog = currentPath.startsWith("/blog");
const base = import.meta.env.BASE_URL;
const homeHref = base;
const blogHref = `${base}blog/`;
const contactHref = `${base}#contact`;
---

<header>
  <nav class="blog-nav">
    <a href={homeHref} class="blog-brand">Davit Maisuradze</a>

    <div class="blog-nav-links" aria-label="Primary">
      <a href={homeHref} class:list={{ "is-active": isHome }}>Home</a>
      <a href={blogHref} class:list={{ "is-active": isBlog }}>Blog</a>
      <a href={contactHref}>Contact</a>
    </div>
  </nav>
</header>
