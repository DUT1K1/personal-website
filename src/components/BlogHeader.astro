---
const { currentPath = "/" } = Astro.props;
const isHome = currentPath === "/";
const isBlog = currentPath.startsWith("/blog");
const base = import.meta.env.BASE_URL;
const homeHref = base;
const blogHref = `${base}blog/`;
const contactHref = `${base}#contact`;
---

<header class="site-header blog-header">
  <nav class="blog-nav" aria-label="Primary navigation">
    <a href={homeHref} class="blog-brand">Davit Maisuradze</a>

    <div class="blog-nav-links">
      <a href={homeHref} class:list={{ "is-active": isHome }} aria-current={isHome ? "page" : undefined}>Home</a>
      <a href={blogHref} class:list={{ "is-active": isBlog }} aria-current={isBlog ? "page" : undefined}>Blog</a>
      <a href={contactHref}>Contact</a>
    </div>
  </nav>
</header>
